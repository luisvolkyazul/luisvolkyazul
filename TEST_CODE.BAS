    5 REM TEST_CODE.BAS
   10 MODE 27
   20 CLS
   40 DIM XX(4), XY(4), YX(4), YY(4)
   50 XX(2)=0.98 : XY(2)=-0.97
   60 YX(2)=0.90 : YY(2)=0.96
   70 XX(4)=-0.15 : XY(4)=0.28
   80 YX(4)=0.26  : YY(4)=0.24
   90 X=.001 : Y=.001
  100 FOR I=1 TO 30000
  110   R=INT(RND(1)*100)
  120   PRINTTAB(1,1)"R: ";R: IF R < 86 THEN F=2 ELSE F=4
  130   X1=XX(F)*X + XY(F)*Y
  140   Y1=YX(F)*X + YY(F)*Y
  150   X=X1 : Y=Y1
  155   IF ABS(X)>1E10 OR ABS(Y)>1E10 THEN X=.001 : Y=.001
  160   PRINTTAB(1,2)"X: ";X:PRINTTAB(1,3)"Y: ";Y:SX=640 + X*.001
  170   SY=512 + Y*.001
  175   GCOL 0,RND(64)
  180   PLOT 69, SX, SY
  185   IF I MOD 5000=0 PRINTTAB(1,6)'"I: ";I:PRINT
  190   PRINTTAB(1,4)"SX: ";SX:PRINTTAB(1,5)"SY: ";SY:NEXT
  200 PRINT"DONE"
  210 A=GET
