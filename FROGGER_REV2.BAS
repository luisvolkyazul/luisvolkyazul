7000 DEF PROCinit_level REM 7000
7010 DONE%=0
7011 IF RESPAWN%=0 THEN NHOME%=0
7020 FX%=19:FY%=SROW%
7030 TL%=2000-((LEVEL%-1)*10)
7031 IF TL%<80 THEN TL%=80
7032 TL_MAX%=TL%
7033 IF DIFF%=0 THEN DBIAS%=2
7034 IF DIFF%=1 THEN DBIAS%=0
7035 IF DIFF%=2 THEN DBIAS%=-1
7050 REM River rows 2-8: alternating logs/turtles
7060 LDIR%(2)=1:LSPD%(2)=8:LCH%(2)=225:LLEN%(2)=3
7070 LDIR%(3)=-1:LSPD%(3)=6:LCH%(3)=226:LLEN%(3)=6
7080 LDIR%(4)=1:LSPD%(4)=10:LCH%(4)=225:LLEN%(4)=4
7090 LDIR%(5)=-1:LSPD%(5)=7:LCH%(5)=226:LLEN%(5)=6
7100 LDIR%(6)=1:LSPD%(6)=5:LCH%(6)=225:LLEN%(6)=3
7110 LDIR%(7)=-1:LSPD%(7)=9:LCH%(7)=226:LLEN%(7)=6
7115 LDIR%(8)=1:LSPD%(8)=6:LCH%(8)=225:LLEN%(8)=3
7120 REM Road rows 10-17: cars and buses
7130 LDIR%(10)=-1:LSPD%(10)=6:LCH%(10)=227:LLEN%(10)=1
7140 LDIR%(11)=1:LSPD%(11)=8:LCH%(11)=228:LLEN%(11)=1
7150 LDIR%(12)=-1:LSPD%(12)=5:LCH%(12)=230:LLEN%(12)=2
7160 LDIR%(13)=1:LSPD%(13)=7:LCH%(13)=228:LLEN%(13)=1
7170 LDIR%(14)=-1:LSPD%(14)=9:LCH%(14)=227:LLEN%(14)=1
7180 LDIR%(15)=1:LSPD%(15)=4:LCH%(15)=228:LLEN%(15)=1
7182 LDIR%(16)=-1:LSPD%(16)=7:LCH%(16)=230:LLEN%(16)=2
7184 LDIR%(17)=1:LSPD%(17)=6:LCH%(17)=227:LLEN%(17)=1
7190 FOR II%=2 TO 18
7200 IF II%=9 OR II%=18 THEN GOTO 7230
7210 LSPD%(II%)=LSPD%(II%)-(LEVEL%-1)+DBIAS%
7220 IF LSPD%(II%)<2 THEN LSPD%(II%)=2
7225 LTICK%(II%)=0
7230 NEXT II%
7240 FOR LR%=2 TO 18
7250 IF LR%=9 OR LR%=18 THEN GOTO 7290
7260 FOR LO%=0 TO MAXO%-1
7270 LX%(LR%,LO%)=LO%*8
7280 NEXT LO%
7290 NEXT LR%
7300 IF RESPAWN%=1 THEN GOTO 7330
7305 FOR II%=0 TO 4
7310 HFILL%(II%)=0
7315 NEXT II%
7321 REM --- INIT TURTLE DIVE STATE ---
7322 FOR II%=2 TO 18
7323 TDIVE%(II%)=0
7324 REM Stagger initial visible countdown per row to avoid sync
7325 IF II%=3 THEN TTICK%(II%)=60+(DBIAS%*20)
7326 IF II%=5 THEN TTICK%(II%)=90+(DBIAS%*20)
7327 IF II%=7 THEN TTICK%(II%)=45+(DBIAS%*15)
7328 NEXT II%
7329 oldup%=0:olddown%=0:oldleft%=0:oldright%=0
7330 CLS
7333 PROCplace_snake
7334 FLYPAD%=-1:FLYSHOW%=0:FLYTICK%=0:FLYWAIT%=200
7335 FOR R%=2 TO 18:LREDRAW%(R%)=1:NEXT R%
7336 LFCARRY%=0:LFACTIVE%=0:LFTICK%=300
7337 PROCplace_ladyfrog
7338 CROCPAD%=-1:CROCACTIVE%=0:CROCTICK%=0:CROCWAIT%=300
7340 PROCdraw_background
7341 PROCredraw_pads
7342 REM Show difficulty (handled in background draw)
7350 PROCstatus_bar
7360 PROCdraw_frog
7362 IF RESPAWN%=1 THEN INVTICK%=15
7364 RESPAWN%=0
7365 LASTTIME%=TIME
7366 TIMEACC%=0
7367 movedThisFrame%=0
7368 RVRFLAG%=0
7370 ENDPROC
