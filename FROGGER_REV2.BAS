8000 DEF PROCplay_level REM 8000
8010 DONE%=0
8011 TIMEACC%=0
8012 movedThisFrame%=0
8013 RVRFLAG%=0
8015 LASTTIME%=TIME
8020 REPEAT
8022 REM --- STABLE 30 FPS GAME CLOCK BARRIER ---
8024 REPEAT UNTIL TIME >= LASTTIME% + 3
8025 LASTTIME% = TIME
8026 TIMEACC% = TIMEACC% + 1
8027 LUPDATE% = 0
8028 IF TIMEACC% >= 2 THEN LUPDATE% = 1:TIMEACC% = 0
8029 movedThisFrame% = 0
8030 SAVEFX%=FX%:SAVEFY%=FY%
8040 REM Unconditional erase removed - gated on movement
8050 up%=INKEY(-58):down%=INKEY(-42):left%=INKEY(-26):right%=INKEY(-122)
8065 NX%=FX%:NY%=FY%
8070 IF up% AND NOT oldup% THEN NY%=FY%-1:FDIR%=0
8075 IF down% AND NOT olddown% THEN NY%=FY%+1:FDIR%=1
8080 IF left% AND NOT oldleft% THEN NX%=FX%-1:FDIR%=2
8085 IF right% AND NOT oldright% THEN NX%=FX%+1:FDIR%=3
8090 oldup%=up%:olddown%=down%:oldleft%=left%:oldright%=right%
8095 k$=INKEY$(0):IF k$="q" OR k$="Q" THEN DONE%=9
8130 IF NX%<0 THEN NX%=0
8140 IF NX%>COLS%-1 THEN NX%=COLS%-1
8150 IF NY%<HROW% THEN NY%=HROW%
8160 IF NY%>BROW% THEN NY%=BROW%
8165 IF (NX%<>FX% OR NY%<>FY%) AND DONE%=0 THEN PROCjump_sound
8170 IF NY%<FY% AND DONE%=0 THEN SCORE%=SCORE%+10:SOUND 2,-15,220,1
8172 IF SCORE%>=20000 AND BONUSLIFE%=0 THEN LIVES%=LIVES%+1:BONUSLIFE%=1:PROCstatus_bar
8173 IF SCORE%>=20000 AND BONUSLIFE%=1 AND LIVES%>3 THEN SOUND 0,-15,200,2:SOUND 1,-15,240,2
8174 IF BONUSLIFE%=1 AND SCORE%>=20000 AND LIVES%>3 THEN COLOUR 128+0:COLOUR 10:PRINT TAB(9,22);"*** EXTRA LIFE! ***":ZZ%=INKEY(60):PROCclear_message
8175 REM Track whether frog was already on river before this move
8176 PREVRVRFLAG%=RVRFLAG%
8177 IF NY%>=RV1% AND NY%<=RV2% THEN RVRFLAG%=1 ELSE RVRFLAG%=0
8178 IF RVRFLAG%=1 AND PREVRVRFLAG%=0 THEN SOUND 3,-10,60,2
8180 FX%=NX%:FY%=NY%
8182 IF FY%>=RD1% AND FY%<=RD2% AND SAVEFY%<RD1% THEN SOUND 3,-10,80,1
8183 IF FY%>=RD1% AND FY%<=RD2% AND SAVEFY%>RD2% THEN SOUND 3,-10,80,1
8185   IF SAVEFX%<>FX% OR SAVEFY%<>FY% THEN FX%=SAVEFX%:FY%=SAVEFY%:PROCerase_frog:FX%=NX%:FY%=NY%:PROCdraw_frog
8186 REM --- RIVER/ROAD COLLISION (before objects move) ---
8187 IF FY%>=RV1% AND FY%<=RV2% AND DONE%=0 AND INVTICK%=0 THEN PROCriver_check
8188 IF FY%>=RD1% AND FY%<=RD2% AND DONE%=0 AND INVTICK%=0 THEN PROCroad_check
8189 IF FY%=HROW% AND DONE%=0 THEN PROChome_check
8190 REM --- UPDATE GAME OBJECT TICKERS ---
8191 IF LUPDATE%=1 THEN PROCsub_ticker
8260 FOR R%=2 TO 18
8270 IF R%=9 OR R%=18 OR LREDRAW%(R%)=0 THEN GOTO 8350
8285 IF R%>=RV1% AND R%<=RV2% THEN FG%=3
8286 IF R%>=RV1% AND R%<=RV2% AND LCH%(R%)=226 THEN FG%=11
8287 IF R%=10 THEN FG%=1
8288 IF R%=11 THEN FG%=7
8289 IF R%=13 THEN FG%=5
8291 IF R%=14 THEN FG%=1
8292 IF R%=15 THEN FG%=7
8294 IF R%=17 THEN FG%=5
8295 FOR O%=0 TO MAXO%-1
8296 FOR S%=0 TO LLEN%(R%)-1
8310 CX%=(LX%(R%,O%)+S%) MOD COLS%
8320 PROCdraw_obj_tile
8330 NEXT S%
8340 NEXT O%
8345 LREDRAW%(R%)=0
8350 NEXT R%
8351 REM --- DRAW SNAKE ON ITS LOG ---
8352 SNCX%=(LX%(SNROW%,SNOBJ%)+SNOFF%) MOD COLS%
8353 COLOUR 128+4:COLOUR 9:PRINT TAB(SNCX%,SNROW%);CHR$(238);
8354 IF LFACTIVE%=1 AND LFCARRY%=0 THEN LFCX%=(LX%(LFROW%,LFOBJ%)+LFOFF%) MOD COLS%:COLOUR 128+4:COLOUR 13:PRINT TAB(LFCX%,LFROW%);CHR$(224);
8355 PROCrestore_tile
8370 IF FY%>=RV1% AND FY%<=RV2% AND DONE%=0 AND INVTICK%=0 THEN PROCriver_check
8390 IF FY%>=RD1% AND FY%<=RD2% AND DONE%=0 AND INVTICK%=0 THEN PROCroad_check
8410 IF FY%=HROW% AND DONE%=0 THEN PROChome_check
8460 IF DONE%=0 THEN PROCdraw_frog
8470 PROCstatus_bar
8490 UNTIL DONE%<>0
8495 IF DONE%=9 THEN LIVES%=0:DONE%=2
8496 ENDPROC
8497 :
8500 DEF PROCadvance_lane REM 8500
8510 LTICK%(R%)=0
8520 FOR O%=0 TO MAXO%-1
8530 FOR S%=0 TO LLEN%(R%)-1
8540 CX%=(LX%(R%,O%)+S%) MOD COLS%
8550 PROCerase_obj_tile
8560 NEXT S%
8570 NEXT O%
8580 FOR O%=0 TO MAXO%-1
8590 LX%(R%,O%)=LX%(R%,O%)+LDIR%(R%)
8592 IF LX%(R%,O%)<0 THEN LX%(R%,O%)=COLS%-1
8594 IF LX%(R%,O%)>=COLS% THEN LX%(R%,O%)=0
8596 NEXT O%
8597 LREDRAW%(R%)=1
8598 IF R%=FY% THEN movedThisFrame%=1
8599 ENDPROC
8600 DEF PROCriver_check REM 8600
8605 REM If turtle row fully submerged, frog drowns immediately
8606 IF LCH%(FY%)=226 AND TDIVE%(FY%)=2 THEN DTYPE%=1:PROCdie:ENDPROC
8610 OLG%=0
8620 FOR O%=0 TO MAXO%-1
8630 FOR S%=0 TO LLEN%(FY%)-1
8640 CX%=(LX%(FY%,O%)+S%) MOD COLS%
8650 IF CX%=FX% THEN OLG%=1
8660 NEXT S%
8670 NEXT O%
8672 REM --- SNAKE COLLISION CHECK ---
8673 SNCX%=(LX%(SNROW%,SNOBJ%)+SNOFF%) MOD COLS%
8674 IF FY%=SNROW% AND FX%=SNCX% AND OLG%=1 THEN DTYPE%=0:SOUND 3,-15,200,2:PROCdie:ENDPROC
8675 REM Only drift if frog was already riding last frame (not just landed)
8676 IF LFACTIVE%=0 OR LFCARRY%=1 THEN GOTO 8678
8677 LFCX%=(LX%(LFROW%,LFOBJ%)+LFOFF%) MOD COLS%
8678 IF FY%=LFROW% AND FX%=LFCX% AND OLG%=1 THEN LFCARRY%=1:SOUND 2,-15,180,2
8680 IF OLG%=1 AND movedThisFrame%=1 AND PREVRVRFLAG%=1 THEN FX%=FX%+LDIR%(FY%)
8690 IF OLG%=1 AND FX%<0 THEN PROCdie:ENDPROC
8691 IF OLG%=1 AND FX%>COLS%-1 THEN PROCdie:ENDPROC
8694 IF OLG%=0 THEN DTYPE%=1:PROCdie
8696 ENDPROC
8697 :
8700 DEF PROCroad_check REM 8700
8710 FOR O%=0 TO MAXO%-1
8720 FOR S%=0 TO LLEN%(FY%)-1
8730 CX%=(LX%(FY%,O%)+S%) MOD COLS%
8740 IF CX%=FX% AND DONE%=0 THEN DTYPE%=0:PROCdie
8750 NEXT S%
8760 NEXT O%
8770 ENDPROC
8780 :
8800 DEF PROChome_check REM 8800
8810 HIT%=0:PAD%=0
8820 IF FX%=PAD0% THEN PAD%=0:HIT%=1
8830 IF FX%=PAD1% THEN PAD%=1:HIT%=1
8840 IF FX%=PAD2% THEN PAD%=2:HIT%=1
8850 IF FX%=PAD3% THEN PAD%=3:HIT%=1
8860 IF FX%=PAD4% THEN PAD%=4:HIT%=1
8865 IF HIT%=0 THEN PROCdie:ENDPROC
8880 IF HFILL%(PAD%)=1 THEN PROCdie:ENDPROC
8882 IF CROCACTIVE%=1 AND PAD%=CROCPAD% THEN PROCdie:ENDPROC
8890 HFILL%(PAD%)=1
8893 IF FLYSHOW%=0 THEN GOTO 8900
8894 IF PAD%<>FLYPAD% THEN GOTO 8900
8895 SCORE%=SCORE%+200:SOUND 2,-15,240,3
8896 FLYSHOW%=0:FLYPAD%=-1:FLYWAIT%=150+RND(200)
