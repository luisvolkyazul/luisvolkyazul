 2160 DEF PROC_READ_CHARS
 2170 REM Read back first 50 chars from row 0 (top row) using GET$(x,y)
 2180 line1$ = ""
 2190   FOR X% = 0 TO 49
 2200   line1$ = line1$ + GET$(X%, 0)
