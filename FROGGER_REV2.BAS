14000 DEF PROCturtle_dive REM 14000
14005 TTICK%(R%)=TTICK%(R%)-1
14010 IF TTICK%(R%)>0 THEN ENDPROC
14015 REM Timer expired - advance state
14020 IF TDIVE%(R%)=0 THEN TDIVE%(R%)=1:TTICK%(R%)=8:LREDRAW%(R%)=1:SOUND 3,-10,50,2:ENDPROC
14025 REM State 1: warning flash done - go submerged, erase turtles
14030 IF TDIVE%(R%)=1 THEN TDIVE%(R%)=2:TTICK%(R%)=25:PROCerase_turtles:ENDPROC
14035 REM State 2: submerged - resurface, kill frog if still on this row
14036 IF TDIVE%(R%)<>2 THEN GOTO 14050
14040 TDIVE%(R%)=3:TTICK%(R%)=8:LREDRAW%(R%)=1
14042 IF FY%=R% AND DONE%=0 THEN PROCdie
14045 ENDPROC
14050 REM State 3: resurface flash done - back to visible
14055 IF TDIVE%(R%)=3 THEN TDIVE%(R%)=0:TTICK%(R%)=80:LREDRAW%(R%)=1:ENDPROC
14060 ENDPROC
