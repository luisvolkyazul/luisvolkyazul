7510 FOR RP%=0 TO 4
7520 IF HFILL%(RP%)=0 THEN GOTO 7550
7530 COLOUR 128+0:COLOUR 14
7540 PRINT TAB(PAD0%+RP%*8,HROW%);CHR$(224);
